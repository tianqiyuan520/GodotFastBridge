# Godot auto generated files
*.gen.*
.godot/

# Ignore library files but not the gdextension file
/bin/**
!project/bin/*.gdextension

# GFB addon 二进制（只提交 .gdextension 描述符，与 GDJobSystem 的分发约定一致）
project/addons/GodotFastBridge/bin/**
!project/addons/GodotFastBridge/bin/*.gdextension
!project/addons/GodotFastBridge/bin/*.gdextension.uid

# 导出产物
project/build/

# Ignore scons database
.sconsign*.dblite

# Ignore custom.py
custom.py

# Ignore generated compile_commands.json
compile_commands.json

# Ignore files generated for documentation
/src/gen

# Binaries
*.o
*.os
*.so
*.obj
*.bc
*.pyc
*.dblite
*.pdb
*.lib
*.config
*.creator
*.creator.user
*.files
*.includes
*.idb
*.exp

# Other stuff
*.log

# VSCode
.vscode/*
!.vscode/extensions.json
.DS_Store

# Jetbrains
.idea/

# Cmake
cmake-build*
CMakeUserPresets.json
